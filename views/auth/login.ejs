
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SPC Login</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <style>
        body {
            font-family: Arial, Helvetica, sans-serif;
        }

        .login-card {
            background: #ffffff;
            border: 1px solid #cbd5d9;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            position: relative;
            overflow: hidden;
        }

        .leaf {
            position: absolute;
            color: #e8f3ed;
            opacity: 0.65;
            pointer-events: none;
        }

        .input-field {
            height: 43px;
            border: 1px solid #e1e7e9;
            background: #ffffff;
            transition: 0.2s;
        }

        .input-field:focus {
            border-color: #087443;
            box-shadow: 0 0 0 2px rgba(8,116,67,0.10);
            outline: none;
        }

        .login-btn {
            background: #006b3c;
            transition: 0.2s;
        }

        .login-btn:hover {
            background: #00552f;
        }
    </style>
</head>

<body class="min-h-screen bg-gray-100 flex items-center justify-center p-3">

    <div class="login-card w-full max-w-[420px] min-h-[650px] rounded-md px-7 py-10 flex flex-col justify-center">

        <!-- Background Decorations -->
        <i class="fa-solid fa-leaf leaf text-6xl top-8 right-8 rotate-12"></i>
        <i class="fa-solid fa-leaf leaf text-4xl top-32 right-3 -rotate-45"></i>
        <i class="fa-solid fa-leaf leaf text-5xl bottom-20 left-[-12px] rotate-45"></i>

        <!-- SPC Logo -->
        <div class="text-center relative z-10 mb-7">

            <div class="text-6xl text-green-700 mb-1">
                <i class="fa-solid fa-recycle"></i>
            </div>

            <h1 class="text-4xl font-extrabold tracking-tight text-green-900">
                SPC
            </h1>

            <p class="text-[9px] font-bold text-green-800 uppercase tracking-wide">
                Integrated Recycling Company
            </p>

        </div>

        <!-- Welcome -->
        <div class="text-center relative z-10 mb-7">

            <h2 class="text-[22px] font-bold text-slate-800">
                Welcome Back
            </h2>

            <p class="text-sm text-slate-500 mt-1">
                Log in to your account
            </p>

        </div>

        <!-- Error Message -->
        <% if (error) { %>
            <div class="relative z-10 bg-red-50 border border-red-200 text-red-700 p-3 rounded-md mb-4 text-sm">
                <i class="fa-solid fa-circle-exclamation mr-2"></i>
                <%= error %>
            </div>
        <% } %>

        <!-- Login Form -->
        <form action="/login" method="POST" class="relative z-10">

            <!-- Username -->
            <div class="mb-4">

                <div class="relative">

                    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-500 text-sm">
                        <i class="fa-regular fa-user"></i>
                    </span>

                    <input
                        type="text"
                        name="identifier"
                        placeholder="Username or Email"
                        required
                        autocomplete="username"
                        class="input-field w-full rounded-md pl-10 pr-3 text-xs text-gray-700"
                    >

                </div>

            </div>

            <!-- Password -->
            <div class="mb-4">

                <div class="relative">

                    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-500 text-sm">
                        <i class="fa-solid fa-lock"></i>
                    </span>

                    <input
                        type="password"
                        name="password"
                        id="password"
                        placeholder="Password"
                        required
                        autocomplete="current-password"
                        class="input-field w-full rounded-md pl-10 pr-10 text-xs text-gray-700"
                    >

                    <button
                        type="button"
                        onclick="togglePassword()"
                        class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-green-700"
                    >
                        <i id="eyeIcon" class="fa-regular fa-eye text-sm"></i>
                    </button>

                </div>

            </div>

            <!-- Remember Me / Forgot Password -->
            <div class="flex items-center justify-between mb-7 text-[11px]">

                <label class="flex items-center gap-2 text-gray-700 cursor-pointer">
                    <input
                        type="checkbox"
                        name="remember"
                        class="accent-green-700"
                    >
                    Remember me
                </label>

                <a href="/forgot-password"
                   class="text-green-700 font-semibold hover:text-green-900">
                    Forgot password?
                </a>

            </div>

            <!-- Login Button -->
            <button
                type="submit"
                class="login-btn w-full text-white font-semibold text-sm py-3 rounded-md shadow-sm"
            >
                Login
            </button>

        </form>

        <!-- Footer -->
        <div class="relative z-10 text-center mt-10">

            <p class="text-[10px] text-gray-500">
                © <%= new Date().getFullYear() %> SPC Integrated Recycling Company
            </p>

            <p class="text-[10px] text-gray-500 mt-1">
                All rights reserved.
            </p>

        </div>

    </div>

    <script>
        function togglePassword() {
            const password = document.getElementById('password');
            const eyeIcon = document.getElementById('eyeIcon');

            if (password.type === 'password') {
                password.type = 'text';
                eyeIcon.classList.remove('fa-eye');
                eyeIcon.classList.add('fa-eye-slash');
            } else {
                password.type = 'password';
                eyeIcon.classList.remove('fa-eye-slash');
                eyeIcon.classList.add('fa-eye');
            }
        }
    </script>

</body>
</html>
