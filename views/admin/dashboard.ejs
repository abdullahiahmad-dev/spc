<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CEO Dashboard | SPC</title>

    <!-- Same stack as the login page -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

    <style>
        body {
            font-family: Arial, Helvetica, sans-serif;
        }

        /* Sidebar nav items */
        .nav-item { transition: background 0.2s, box-shadow 0.2s; }
        .nav-item:hover { background: rgba(255,255,255,0.08); }
        .nav-item.active {
            background: #006b3c;
            box-shadow: inset 3px 0 0 #ffffff;
        }

        /* KPI card hover lift */
        .kpi-card { transition: transform 0.2s, box-shadow 0.2s; }
        .kpi-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0,107,60,0.10);
        }

        /* Mobile drawer behaviour for the sidebar */
        @media (max-width: 1023px) {
            #sidebar {
                transform: translateX(-100%);
                transition: transform 0.25s ease;
            }
            #sidebar.open { transform: translateX(0); }
        }

        /* Thin, subtle scrollbar */
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-thumb { background: #cbd5d9; border-radius: 4px; }
        ::-webkit-scrollbar-track { background: transparent; }
    </style>
</head>

<body class="bg-gray-100 min-h-screen">

<%
// ─────────────────────────────────────────────────────────────
// Safe defaults so the page renders even if the Express route
// doesn't pass every local. Pass these from your route to override:
//
//   res.render('ceo-dashboard', {
//     user, dateRange, kpis, branchPerformance, topMaterials
//   });
//
//   kpis = {
//     purchase: { value: '₦12,450,000', change: 8 },
//     sales:    { value: '₦15,320,000', change: 12 },
//     profit:   { value: '₦2,870,000',  change: 10 },
//     branches: { value: '8', status: 'All active' }
//   }
//   branchPerformance = { labels:[...], sales:[...], purchase:[...] }
//   topMaterials = { total:'15.3M', items:[{name,value,color}, ...] }
//
// Reads via `locals.X` to avoid EJS `with(locals)` TDZ issues when
// a local has the same name as one of our `const` defaults.
// ─────────────────────────────────────────────────────────────

const _user      = locals.user || {};
const ceoName    = (_user && _user.fullName) ? _user.fullName : 'CEO User';
const ceoInitial = ceoName.charAt(0).toUpperCase();
const dateRange  = locals.dateRange || 'April 1 – April 30, 2025';

const defKpis = {
    purchase:  { value: '₦12,450,000', change:  8 },
    sales:     { value: '₦15,320,000', change: 12 },
    profit:    { value: '₦2,870,000',  change: 10 },
    branches:  { value: '8', status: 'All active' }
};
const _kpis = locals.kpis || {};
const k = {
    purchase: Object.assign({}, defKpis.purchase,  _kpis.purchase  || {}),
    sales:    Object.assign({}, defKpis.sales,     _kpis.sales     || {}),
    profit:   Object.assign({}, defKpis.profit,    _kpis.profit    || {}),
    branches: Object.assign({}, defKpis.branches,  _kpis.branches  || {})
};

const defBranch = {
    labels:   ['Kaduna','Kano','Lagos','Abuja','Benin','Kogi','Katsina','Plateau'],
    sales:    [3200000, 2800000, 4100000, 2900000, 1800000, 1500000, 1100000, 800000],
    purchase: [2800000, 2500000, 3500000, 2600000, 1500000, 1300000,  950000, 700000]
};
const branchPerformance = locals.branchPerformance || defBranch;

const defMaterials = {
    total: '15.3M',
    items: [
        { name: 'Mix',      value: 32, color: '#006b3c' },
        { name: 'Special',  value: 28, color: '#087443' },
        { name: 'Car Body', value: 20, color: '#3a9d6e' },
        { name: 'Others',   value: 20, color: '#a8d5b8' }
    ]
};
const topMaterials = locals.topMaterials || defMaterials;
%>

<div class="flex min-h-screen">

    <!-- ───────────── Sidebar ───────────── -->
    <aside id="sidebar"
           class="fixed lg:static inset-y-0 left-0 z-40 w-64 bg-green-950 text-white flex flex-col">

        <!-- Brand -->
        <div class="px-5 py-5 border-b border-green-900/60 flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-green-700 flex items-center justify-center flex-shrink-0">
                <i class="fa-solid fa-recycle text-white text-lg"></i>
            </div>
            <div class="min-w-0">
                <h1 class="text-lg font-extrabold tracking-tight leading-tight">SPC</h1>
                <p class="text-[10px] uppercase tracking-wider text-green-300 truncate">Integrated Recycling</p>
            </div>
        </div>

        <!-- Nav -->
        <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">
            <a href="/ceo/dashboard"
               class="nav-item active flex items-center gap-3 px-3 py-2.5 rounded-md text-sm font-medium">
                <i class="fa-solid fa-gauge-high w-5 text-center"></i>
                <span>Dashboard</span>
            </a>
            <a href="/ceo/branch-reports"
               class="nav-item flex items-center gap-3 px-3 py-2.5 rounded-md text-sm text-green-100">
                <i class="fa-solid fa-file-lines w-5 text-center"></i>
                <span>Branch Reports</span>
            </a>
            <a href="/ceo/branches"
               class="nav-item flex items-center gap-3 px-3 py-2.5 rounded-md text-sm text-green-100">
                <i class="fa-solid fa-building w-5 text-center"></i>
                <span>All Branches</span>
            </a>
            <a href="/ceo/financial"
               class="nav-item flex items-center gap-3 px-3 py-2.5 rounded-md text-sm text-green-100">
                <i class="fa-solid fa-chart-line w-5 text-center"></i>
                <span>Financial Overview</span>
            </a>
            <a href="/ceo/reports"
               class="nav-item flex items-center gap-3 px-3 py-2.5 rounded-md text-sm text-green-100">
                <i class="fa-solid fa-folder-open w-5 text-center"></i>
                <span>Reports</span>
            </a>
            <a href="/ceo/settings"
               class="nav-item flex items-center gap-3 px-3 py-2.5 rounded-md text-sm text-green-100">
                <i class="fa-solid fa-gear w-5 text-center"></i>
                <span>Settings</span>
            </a>
        </nav>

        <!-- Sidebar footer (mini user card + logout) -->
        <div class="p-3 border-t border-green-900/60">
            <div class="flex items-center gap-3 px-2 py-2">
                <div class="w-9 h-9 rounded-full bg-green-700 flex items-center justify-center font-bold text-sm flex-shrink-0">
                    <%= ceoInitial %>
                </div>
                <div class="min-w-0 flex-1">
                    <p class="text-sm font-semibold truncate"><%= ceoName %></p>
                    <p class="text-[11px] text-green-300 truncate">Chief Executive Officer</p>
                </div>
                <form action="/logout" method="POST">
                    <button type="submit"
                            class="text-green-300 hover:text-white transition"
                            title="Logout">
                        <i class="fa-solid fa-right-from-bracket"></i>
                    </button>
                </form>
            </div>
        </div>
    </aside>

    <!-- Mobile overlay -->
    <div id="overlay" class="hidden lg:hidden fixed inset-0 bg-black/40 z-30"></div>

    <!-- ───────────── Main column ───────────── -->
    <div class="flex-1 flex flex-col min-w-0">

        <!-- Top header -->
        <header class="bg-white border-b border-gray-200 sticky top-0 z-20">
            <div class="flex items-center justify-between gap-3 px-4 sm:px-6 py-3">

                <div class="flex items-center gap-3 min-w-0">
                    <button id="menuToggle"
                            class="lg:hidden text-gray-600 hover:text-green-700 text-xl">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <div class="min-w-0">
                        <h2 class="text-base sm:text-lg font-bold text-gray-800 truncate">CEO Dashboard</h2>
                        <p class="text-[11px] sm:text-xs text-gray-500 truncate">Company overview and branch performance</p>
                    </div>
                </div>

                <div class="flex items-center gap-3 sm:gap-4 flex-shrink-0">
                    <!-- Date range pill -->
                    <div class="hidden sm:flex items-center gap-2 bg-green-50 text-green-800 border border-green-200 rounded-md px-3 py-1.5 text-xs font-semibold">
                        <i class="fa-regular fa-calendar"></i>
                        <span><%= dateRange %></span>
                    </div>

                    <!-- User -->
                    <div class="flex items-center gap-2">
                        <div class="w-9 h-9 rounded-full bg-green-700 text-white flex items-center justify-center font-bold text-sm">
                            <%= ceoInitial %>
                        </div>
                        <div class="hidden md:block leading-tight">
                            <p class="text-sm font-semibold text-gray-800"><%= ceoName %></p>
                            <p class="text-[11px] text-gray-500">CEO</p>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <!-- Main content -->
        <main class="p-4 sm:p-6 flex-1">

            <!-- Welcome -->
            <div class="mb-6">
                <h3 class="text-xl sm:text-2xl font-bold text-gray-800">
                    Welcome back, <%= ceoName %>
                </h3>
                <p class="text-gray-500 text-sm mt-1">
                    You are logged in as the Company CEO. Here's the snapshot for the current period.
                </p>
            </div>

            <!-- KPI cards -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">

                <!-- Total Purchase -->
                <div class="kpi-card bg-white rounded-lg shadow-sm border border-gray-100 p-5">
                    <div class="flex items-start justify-between">
                        <div class="min-w-0">
                            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Total Purchase</p>
                            <p class="text-2xl font-bold text-gray-800 mt-1.5 truncate"><%= k.purchase.value %></p>
                        </div>
                        <div class="w-10 h-10 rounded-md bg-green-100 text-green-700 flex items-center justify-center flex-shrink-0">
                            <i class="fa-solid fa-cart-shopping"></i>
                        </div>
                    </div>
                    <div class="flex items-center gap-1.5 mt-3 text-xs">
                        <span class="text-green-700 font-semibold flex items-center gap-1">
                            <i class="fa-solid fa-arrow-up"></i> <%= k.purchase.change %>%
                        </span>
                        <span class="text-gray-400">vs last month</span>
                    </div>
                </div>

                <!-- Total Sales -->
                <div class="kpi-card bg-white rounded-lg shadow-sm border border-gray-100 p-5">
                    <div class="flex items-start justify-between">
                        <div class="min-w-0">
                            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Total Sales</p>
                            <p class="text-2xl font-bold text-gray-800 mt-1.5 truncate"><%= k.sales.value %></p>
                        </div>
                        <div class="w-10 h-10 rounded-md bg-green-100 text-green-700 flex items-center justify-center flex-shrink-0">
                            <i class="fa-solid fa-naira-sign"></i>
                        </div>
                    </div>
                    <div class="flex items-center gap-1.5 mt-3 text-xs">
                        <span class="text-green-700 font-semibold flex items-center gap-1">
                            <i class="fa-solid fa-arrow-up"></i> <%= k.sales.change %>%
                        </span>
                        <span class="text-gray-400">vs last month</span>
                    </div>
                </div>

                <!-- Total Profit -->
                <div class="kpi-card bg-white rounded-lg shadow-sm border border-gray-100 p-5">
                    <div class="flex items-start justify-between">
                        <div class="min-w-0">
                            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Total Profit</p>
                            <p class="text-2xl font-bold text-gray-800 mt-1.5 truncate"><%= k.profit.value %></p>
                        </div>
                        <div class="w-10 h-10 rounded-md bg-green-100 text-green-700 flex items-center justify-center flex-shrink-0">
                            <i class="fa-solid fa-chart-line"></i>
                        </div>
                    </div>
                    <div class="flex items-center gap-1.5 mt-3 text-xs">
                        <span class="text-green-700 font-semibold flex items-center gap-1">
                            <i class="fa-solid fa-arrow-up"></i> <%= k.profit.change %>%
                        </span>
                        <span class="text-gray-400">vs last month</span>
                    </div>
                </div>

                <!-- Total Branches -->
                <div class="kpi-card bg-white rounded-lg shadow-sm border border-gray-100 p-5">
                    <div class="flex items-start justify-between">
                        <div class="min-w-0">
                            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Total Branches</p>
                            <p class="text-2xl font-bold text-gray-800 mt-1.5 truncate"><%= k.branches.value %></p>
                        </div>
                        <div class="w-10 h-10 rounded-md bg-green-100 text-green-700 flex items-center justify-center flex-shrink-0">
                            <i class="fa-solid fa-building"></i>
                        </div>
                    </div>
                    <div class="flex items-center gap-1.5 mt-3 text-xs">
                        <span class="text-green-700 font-semibold flex items-center gap-1">
                            <i class="fa-solid fa-circle-check"></i> <%= k.branches.status %>
                        </span>
                    </div>
                </div>
            </div>

            <!-- Charts -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">

                <!-- Branch performance (bar chart) -->
                <div class="lg:col-span-2 bg-white rounded-lg shadow-sm border border-gray-100 p-5">
                    <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
                        <div>
                            <h4 class="font-bold text-gray-800">Branch Performance</h4>
                            <p class="text-xs text-gray-500">Sales vs Purchase by branch</p>
                        </div>
                        <div class="flex items-center gap-3 text-xs">
                            <span class="flex items-center gap-1.5">
                                <span class="w-2.5 h-2.5 rounded-sm" style="background:#006b3c"></span>
                                <span class="text-gray-600">Sales</span>
                            </span>
                            <span class="flex items-center gap-1.5">
                                <span class="w-2.5 h-2.5 rounded-sm" style="background:#a8d5b8"></span>
                                <span class="text-gray-600">Purchase</span>
                            </span>
                        </div>
                    </div>
                    <div class="h-72 sm:h-80">
                        <canvas id="branchChart"></canvas>
                    </div>
                </div>

                <!-- Top materials (donut chart) -->
                <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-5">
                    <h4 class="font-bold text-gray-800">Top Materials</h4>
                    <p class="text-xs text-gray-500 mb-4">Share of total volume</p>

                    <div class="relative h-48">
                        <canvas id="materialsChart"></canvas>
                        <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none">
                            <p class="text-[11px] text-gray-500">Total</p>
                            <p class="text-xl font-bold text-gray-800"><%= topMaterials.total %></p>
                        </div>
                    </div>

                    <!-- Custom legend -->
                    <div class="mt-5 space-y-2.5" id="materialsLegend"></div>
                </div>
            </div>

            <!-- Top performing branches (table, computed server-side) -->
            <%
            const branchRows = branchPerformance.labels.map((label, i) => ({
                name: label,
                sales: branchPerformance.sales[i] || 0,
                purchase: branchPerformance.purchase[i] || 0,
                profit: (branchPerformance.sales[i] || 0) - (branchPerformance.purchase[i] || 0)
            })).sort((a, b) => b.sales - a.sales);

            const maxSales = branchRows.length ? branchRows[0].sales : 1;
            const fmtNairaTable = n => '₦' + n.toLocaleString('en-NG');
            %>

            <div class="mt-4 bg-white rounded-lg shadow-sm border border-gray-100 p-5">
                <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
                    <div>
                        <h4 class="font-bold text-gray-800">Top Performing Branches</h4>
                        <p class="text-xs text-gray-500">Ranked by sales this period</p>
                    </div>
                    <a href="/ceo/branches"
                       class="text-xs font-semibold text-green-700 hover:text-green-900 flex items-center gap-1">
                        View all <i class="fa-solid fa-arrow-right text-[10px]"></i>
                    </a>
                </div>

                <div class="overflow-x-auto -mx-1 px-1">
                    <table class="w-full text-sm" style="min-width: 600px">
                        <thead>
                            <tr class="text-left text-[11px] uppercase tracking-wide text-gray-500 border-b border-gray-200">
                                <th class="py-2 pr-4 font-semibold">#</th>
                                <th class="py-2 pr-4 font-semibold">Branch</th>
                                <th class="py-2 pr-4 font-semibold text-right">Sales</th>
                                <th class="py-2 pr-4 font-semibold text-right">Purchase</th>
                                <th class="py-2 pr-4 font-semibold text-right">Profit</th>
                                <th class="py-2 pl-2 font-semibold w-[28%] hidden sm:table-cell">Performance</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% branchRows.forEach((row, idx) => { %>
                                <tr class="border-b border-gray-100 last:border-0 hover:bg-green-50/40 transition">
                                    <td class="py-3 pr-4 text-gray-400 font-semibold"><%= idx + 1 %></td>
                                    <td class="py-3 pr-4">
                                        <div class="flex items-center gap-2">
                                            <span class="w-7 h-7 rounded-full bg-green-100 text-green-700 flex items-center justify-center text-xs font-bold">
                                                <%= row.name.charAt(0) %>
                                            </span>
                                            <span class="font-medium text-gray-800"><%= row.name %></span>
                                        </div>
                                    </td>
                                    <td class="py-3 pr-4 text-right font-semibold text-gray-800"><%= fmtNairaTable(row.sales) %></td>
                                    <td class="py-3 pr-4 text-right text-gray-600"><%= fmtNairaTable(row.purchase) %></td>
                                    <td class="py-3 pr-4 text-right font-semibold text-green-700"><%= fmtNairaTable(row.profit) %></td>
                                    <td class="py-3 pl-2 hidden sm:table-cell">
                                        <div class="flex items-center gap-2">
                                            <div class="flex-1 h-1.5 bg-gray-100 rounded-full overflow-hidden">
                                                <div class="h-full bg-green-700 rounded-full"
                                                     style="width:<%= (row.sales / maxSales * 100).toFixed(1) %>%"></div>
                                            </div>
                                            <span class="text-[11px] text-gray-500 w-9 text-right"><%= (row.sales / maxSales * 100).toFixed(0) %>%</span>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>

        </main>
    </div>
</div>

<script>
    // ─── Sidebar drawer (mobile) ───
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('overlay');
    const menuToggle = document.getElementById('menuToggle');

    menuToggle?.addEventListener('click', () => {
        sidebar.classList.add('open');
        overlay.classList.remove('hidden');
    });
    overlay?.addEventListener('click', () => {
        sidebar.classList.remove('open');
        overlay.classList.add('hidden');
    });

    // ─── Charts ───
    // Data is injected server-side from EJS locals (with safe defaults).
    const branchData    = <%- JSON.stringify(branchPerformance) %>;
    const materialsData = <%- JSON.stringify(topMaterials) %>;

    const fmtNaira = n => '₦' + (n / 1000000).toFixed(1).replace(/\.0$/, '') + 'M';

    // Branch performance — grouped bar chart
    new Chart(document.getElementById('branchChart'), {
        type: 'bar',
        data: {
            labels: branchData.labels,
            datasets: [
                {
                    label: 'Sales',
                    data: branchData.sales,
                    backgroundColor: '#006b3c',
                    borderRadius: 4,
                    barPercentage: 0.7,
                    categoryPercentage: 0.6
                },
                {
                    label: 'Purchase',
                    data: branchData.purchase,
                    backgroundColor: '#a8d5b8',
                    borderRadius: 4,
                    barPercentage: 0.7,
                    categoryPercentage: 0.6
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: {
                    backgroundColor: '#003322',
                    titleColor: '#ffffff',
                    bodyColor: '#e8f3ed',
                    padding: 10,
                    callbacks: { label: ctx => ctx.dataset.label + ': ' + fmtNaira(ctx.raw) }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    max: 5000000,
                    ticks: {
                        callback: v => '₦' + (v / 1000000) + 'M',
                        color: '#9ca3af',
                        font: { size: 11 }
                    },
                    grid: { color: '#f1f5f9' }
                },
                x: {
                    ticks: { color: '#6b7280', font: { size: 11 } },
                    grid: { display: false }
                }
            }
        }
    });

    // Top materials — doughnut chart
    new Chart(document.getElementById('materialsChart'), {
        type: 'doughnut',
        data: {
            labels: materialsData.items.map(m => m.name),
            datasets: [{
                data: materialsData.items.map(m => m.value),
                backgroundColor: materialsData.items.map(m => m.color),
                borderWidth: 0,
                hoverOffset: 4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '70%',
            plugins: {
                legend: { display: false },
                tooltip: {
                    backgroundColor: '#003322',
                    titleColor: '#ffffff',
                    bodyColor: '#e8f3ed',
                    padding: 10,
                    callbacks: { label: ctx => ctx.label + ': ' + ctx.raw + '%' }
                }
            }
        }
    });

    // Custom legend for the materials donut
    const legendEl = document.getElementById('materialsLegend');
    legendEl.innerHTML = materialsData.items.map(m => `
        <div class="flex items-center justify-between text-xs">
            <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-sm" style="background:${m.color}"></span>
                <span class="text-gray-600 font-medium">${m.name}</span>
            </div>
            <span class="font-semibold text-gray-800">${m.value}%</span>
        </div>
    `).join('');
</script>

</body>
</html>