<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage CEOs | SPC</title>

    <!-- Same stack as the login + other SPC dashboards -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <style>
        body {
            font-family: Arial, Helvetica, sans-serif;
        }

        .nav-item { transition: background 0.2s, box-shadow 0.2s; }
        .nav-item:hover { background: rgba(255,255,255,0.08); }
        .nav-item.active {
            background: #006b3c;
            box-shadow: inset 3px 0 0 #ffffff;
        }

        /* Inputs styled to match the SPC login page */
        .input-field {
            height: 43px;
            border: 1px solid #e1e7e9;
            background: #ffffff;
            transition: 0.2s;
        }
        .input-field:focus {
            border-color: #087443;
            box-shadow: 0 0 0 2px rgba(8,116,67,0.10);
            outline: none;
        }

        .submit-btn {
            background: #006b3c;
            transition: 0.2s;
        }
        .submit-btn:hover { background: #00552f; }

        @media (max-width: 1023px) {
            #sidebar {
                transform: translateX(-100%);
                transition: transform 0.25s ease;
            }
            #sidebar.open { transform: translateX(0); }
        }

        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-thumb { background: #cbd5d9; border-radius: 4px; }
        ::-webkit-scrollbar-track { background: transparent; }
    </style>
</head>

<body class="bg-gray-100 min-h-screen">

<%
// ─────────────────────────────────────────────────────────────
// Safe defaults so the page renders even if the Express route
// doesn't pass every local. Pass these from your route to override:
//
//   res.render('manage-ceos', {
//     user,          // { fullName } — super admin
//     admins         // [{ _id, fullName, username, email, isActive }]
//   });
//
// Reads via `locals.X` to avoid EJS `with(locals)` TDZ issues.
// ─────────────────────────────────────────────────────────────

const _user         = locals.user || {};
const adminName     = (_user && _user.fullName) ? _user.fullName : 'Super Admin';
const adminInitial  = adminName.charAt(0).toUpperCase();

const admins = locals.admins || [];

const totalAdmins    = admins.length;
const activeAdmins   = admins.filter(a => a.isActive).length;
const inactiveAdmins = totalAdmins - activeAdmins;

const statusBadge = {
    active:   'bg-green-100 text-green-800 border-green-200',
    inactive: 'bg-red-100 text-red-700 border-red-200'
};
%>

<div class="flex min-h-screen">

    <!-- ───────────── Sidebar ───────────── -->
    <aside id="sidebar"
           class="fixed lg:static inset-y-0 left-0 z-40 w-64 bg-green-950 text-white flex flex-col">

        <!-- Brand -->
        <div class="px-5 py-5 border-b border-green-900/60 flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-green-700 flex items-center justify-center flex-shrink-0">
                <i class="fa-solid fa-recycle text-white text-lg"></i>
            </div>
            <div class="min-w-0">
                <h1 class="text-lg font-extrabold tracking-tight leading-tight">SPC</h1>
                <p class="text-[10px] uppercase tracking-wider text-green-300 truncate">Super Admin</p>
            </div>
        </div>

        <!-- Nav -->
        <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">
            <a href="/superadmin/dashboard"
               class="nav-item flex items-center gap-3 px-3 py-2.5 rounded-md text-sm text-green-100">
                <i class="fa-solid fa-gauge-high w-5 text-center"></i>
                <span>Dashboard</span>
            </a>
            <a href="/superadmin/admins"
               class="nav-item active flex items-center gap-3 px-3 py-2.5 rounded-md text-sm font-medium">
                <i class="fa-solid fa-user-tie w-5 text-center"></i>
                <span>CEO Accounts</span>
            </a>
            <a href="/superadmin/branches"
               class="nav-item flex items-center gap-3 px-3 py-2.5 rounded-md text-sm text-green-100">
                <i class="fa-solid fa-building w-5 text-center"></i>
                <span>Branches</span>
            </a>
            <a href="/superadmin/managers"
               class="nav-item flex items-center gap-3 px-3 py-2.5 rounded-md text-sm text-green-100">
                <i class="fa-solid fa-users w-5 text-center"></i>
                <span>Branch Managers</span>
            </a>
            <a href="/superadmin/materials"
               class="nav-item flex items-center gap-3 px-3 py-2.5 rounded-md text-sm text-green-100">
                <i class="fa-solid fa-recycle w-5 text-center"></i>
                <span>Materials</span>
            </a>
            <a href="/superadmin/price-lists"
               class="nav-item flex items-center gap-3 px-3 py-2.5 rounded-md text-sm text-green-100">
                <i class="fa-solid fa-tags w-5 text-center"></i>
                <span>Price Lists</span>
            </a>
            <a href="/superadmin/reports"
               class="nav-item flex items-center gap-3 px-3 py-2.5 rounded-md text-sm text-green-100">
                <i class="fa-solid fa-folder-open w-5 text-center"></i>
                <span>Reports</span>
            </a>
            <a href="/superadmin/settings"
               class="nav-item flex items-center gap-3 px-3 py-2.5 rounded-md text-sm text-green-100">
                <i class="fa-solid fa-gear w-5 text-center"></i>
                <span>Settings</span>
            </a>
        </nav>

        <!-- Sidebar footer (mini user card + logout) -->
        <div class="p-3 border-t border-green-900/60">
            <div class="flex items-center gap-3 px-2 py-2">
                <div class="w-9 h-9 rounded-full bg-green-700 flex items-center justify-center font-bold text-sm flex-shrink-0">
                    <%= adminInitial %>
                </div>
                <div class="min-w-0 flex-1">
                    <p class="text-sm font-semibold truncate"><%= adminName %></p>
                    <p class="text-[11px] text-green-300 truncate">Super Administrator</p>
                </div>
                <form action="/logout" method="POST">
                    <button type="submit"
                            class="text-green-300 hover:text-white transition"
                            title="Logout">
                        <i class="fa-solid fa-right-from-bracket"></i>
                    </button>
                </form>
            </div>
        </div>
    </aside>

    <!-- Mobile overlay -->
    <div id="overlay" class="hidden lg:hidden fixed inset-0 bg-black/40 z-30"></div>

    <!-- ───────────── Main column ───────────── -->
    <div class="flex-1 flex flex-col min-w-0">

        <!-- Top header -->
        <header class="bg-white border-b border-gray-200 sticky top-0 z-20">
            <div class="flex items-center justify-between gap-3 px-4 sm:px-6 py-3">

                <div class="flex items-center gap-3 min-w-0">
                    <button id="menuToggle"
                            class="lg:hidden text-gray-600 hover:text-green-700 text-xl">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <div class="min-w-0">
                        <h2 class="text-base sm:text-lg font-bold text-gray-800 truncate">Manage CEOs</h2>
                        <p class="text-[11px] sm:text-xs text-gray-500 truncate">Create and oversee company CEO accounts</p>
                    </div>
                </div>

                <div class="flex items-center gap-3 sm:gap-4 flex-shrink-0">
                    <a href="/superadmin/dashboard"
                       class="hidden sm:inline-flex items-center gap-1.5 text-xs font-semibold text-green-700 hover:text-green-900 border border-green-200 bg-green-50 rounded-md px-3 py-1.5">
                        <i class="fa-solid fa-arrow-left text-[10px]"></i>
                        Dashboard
                    </a>

                    <div class="flex items-center gap-2">
                        <div class="w-9 h-9 rounded-full bg-green-700 text-white flex items-center justify-center font-bold text-sm">
                            <%= adminInitial %>
                        </div>
                        <div class="hidden md:block leading-tight">
                            <p class="text-sm font-semibold text-gray-800"><%= adminName %></p>
                            <p class="text-[11px] text-gray-500">Super Admin</p>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <!-- Main content -->
        <main class="p-4 sm:p-6 flex-1">

            <!-- Breadcrumb + heading -->
            <div class="mb-6">
                <nav class="text-xs text-gray-500 mb-2 flex items-center gap-1.5">
                    <a href="/superadmin/dashboard" class="hover:text-green-700">Super Admin</a>
                    <i class="fa-solid fa-chevron-right text-[8px] text-gray-300"></i>
                    <span class="text-gray-700 font-medium">CEO Accounts</span>
                </nav>
                <h3 class="text-xl sm:text-2xl font-bold text-gray-800">Manage CEO Accounts</h3>
                <p class="text-gray-500 text-sm mt-1">
                    Create and oversee company Chief Executive Officer accounts.
                </p>
            </div>

            <!-- Stats row -->
            <div class="grid grid-cols-3 gap-3 sm:gap-4 mb-6">
                <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-4">
                    <p class="text-[11px] font-semibold text-gray-500 uppercase tracking-wide">Total</p>
                    <p class="text-xl sm:text-2xl font-bold text-gray-800 mt-1"><%= totalAdmins %></p>
                </div>
                <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-4">
                    <p class="text-[11px] font-semibold text-gray-500 uppercase tracking-wide">Active</p>
                    <p class="text-xl sm:text-2xl font-bold text-green-700 mt-1"><%= activeAdmins %></p>
                </div>
                <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-4">
                    <p class="text-[11px] font-semibold text-gray-500 uppercase tracking-wide">Inactive</p>
                    <p class="text-xl sm:text-2xl font-bold text-red-600 mt-1"><%= inactiveAdmins %></p>
                </div>
            </div>

            <!-- ───────────── Create form ───────────── -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-5 mb-6">
                <div class="flex items-center gap-3 mb-5">
                    <div class="w-9 h-9 rounded-md bg-green-100 text-green-700 flex items-center justify-center flex-shrink-0">
                        <i class="fa-solid fa-user-tie"></i>
                    </div>
                    <div>
                        <h4 class="font-bold text-gray-800">Create New CEO Account</h4>
                        <p class="text-xs text-gray-500">Provision a new Chief Executive Officer account</p>
                    </div>
                </div>

                <form action="/superadmin/admins/create" method="POST">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

                        <!-- Full Name -->
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1.5">Full Name</label>
                            <div class="relative">
                                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm">
                                    <i class="fa-regular fa-user"></i>
                                </span>
                                <input type="text" name="fullName" required
                                       placeholder="Enter CEO full name"
                                       class="input-field w-full rounded-md pl-10 pr-3 text-sm text-gray-700">
                            </div>
                        </div>

                        <!-- Username -->
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1.5">Username</label>
                            <div class="relative">
                                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm">
                                    <i class="fa-solid fa-at"></i>
                                </span>
                                <input type="text" name="username" required
                                       placeholder="Enter username"
                                       class="input-field w-full rounded-md pl-10 pr-3 text-sm text-gray-700">
                            </div>
                        </div>

                        <!-- Email -->
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1.5">Email Address</label>
                            <div class="relative">
                                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm">
                                    <i class="fa-regular fa-envelope"></i>
                                </span>
                                <input type="email" name="email" required
                                       placeholder="Enter email"
                                       class="input-field w-full rounded-md pl-10 pr-3 text-sm text-gray-700">
                            </div>
                        </div>

                        <!-- Password -->
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1.5">Temporary Password</label>
                            <div class="relative">
                                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm">
                                    <i class="fa-solid fa-lock"></i>
                                </span>
                                <input type="password" name="password" minlength="8" required
                                       id="ceoPassword"
                                       placeholder="Minimum 8 characters"
                                       class="input-field w-full rounded-md pl-10 pr-10 text-sm text-gray-700">
                                <button type="button"
                                        onclick="toggleCeoPwd()"
                                        class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-green-700">
                                    <i id="ceoEyeIcon" class="fa-regular fa-eye text-sm"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="flex items-center justify-between mt-5 pt-5 border-t border-gray-100 flex-wrap gap-3">
                        <p class="text-xs text-gray-500 flex items-center gap-1.5">
                            <i class="fa-solid fa-circle-info"></i>
                            The CEO will be prompted to change this password on first login.
                        </p>
                        <button type="submit"
                                class="submit-btn text-white font-semibold text-sm px-5 py-2.5 rounded-md shadow-sm inline-flex items-center gap-2">
                            <i class="fa-solid fa-user-tie"></i>
                            Create CEO Account
                        </button>
                    </div>
                </form>
            </div>

            <!-- ───────────── CEO Accounts table ───────────── -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-5">
                <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
                    <div>
                        <h4 class="font-bold text-gray-800">Existing CEO Accounts</h4>
                        <p class="text-xs text-gray-500">
                            <%= totalAdmins %> account<%= totalAdmins === 1 ? '' : 's' %> total
                        </p>
                    </div>
                    <div class="relative">
                        <span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-gray-400 text-xs">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </span>
                        <input id="ceoSearch" type="text" placeholder="Search..."
                               class="h-8 w-40 sm:w-56 rounded-md border border-gray-200 pl-7 pr-3 text-xs text-gray-700 focus:outline-none focus:border-green-700 focus:ring-2 focus:ring-green-700/10">
                    </div>
                </div>

                <div class="overflow-x-auto -mx-1 px-1">
                    <table class="w-full text-sm md:min-w-[760px] table-fixed md:table-auto" id="ceoTable">
                        <thead>
                            <tr class="text-left text-[11px] uppercase tracking-wide text-gray-500 border-b border-gray-200">
                                <th class="py-2 pr-4 font-semibold w-[50%] md:w-auto">CEO</th>
                                <th class="py-2 pr-4 font-semibold hidden md:table-cell">Username</th>
                                <th class="py-2 pr-4 font-semibold hidden md:table-cell">Email</th>
                                <th class="py-2 pr-4 font-semibold w-[22%] md:w-auto">Status</th>
                                <th class="py-2 pr-4 font-semibold text-right w-[28%] md:w-auto">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (admins.length === 0) { %>
                                <tr>
                                    <td colspan="5" class="py-12 text-center">
                                        <div class="inline-flex flex-col items-center gap-2 text-gray-400">
                                            <i class="fa-solid fa-user-tie text-3xl"></i>
                                            <p class="text-sm font-medium text-gray-600">No CEO accounts created yet</p>
                                            <p class="text-xs text-gray-400">Use the form above to create your first CEO account.</p>
                                        </div>
                                    </td>
                                </tr>
                            <% } else { %>
                                <% admins.forEach(admin => { %>
                                    <tr class="border-b border-gray-100 last:border-0 hover:bg-green-50/40 transition"
                                        data-search="<%= ((admin.fullName || '') + ' ' + (admin.username || '') + ' ' + (admin.email || '')).toLowerCase() %>">
                                        <td class="py-3 pr-4 min-w-0">
                                            <div class="flex items-center gap-2.5 min-w-0">
                                                <span class="w-8 h-8 rounded-full bg-green-100 text-green-700 flex items-center justify-center text-xs font-bold flex-shrink-0">
                                                    <%= (admin.fullName || '?').charAt(0) %>
                                                </span>
                                                <div class="min-w-0 flex flex-col">
                                                    <span class="font-medium text-gray-800 truncate" title="<%= admin.fullName %>"><%= admin.fullName %></span>
                                                    <span class="text-[11px] text-gray-400 truncate md:hidden"><%= admin.email %></span>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="py-3 pr-4 text-gray-600 hidden md:table-cell"><%= admin.username %></td>
                                        <td class="py-3 pr-4 text-gray-600 hidden md:table-cell">
                                            <span class="truncate block max-w-[220px]" title="<%= admin.email %>"><%= admin.email %></span>
                                        </td>
                                        <td class="py-3 pr-4">
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold border <%= admin.isActive ? statusBadge.active : statusBadge.inactive %>">
                                                <i class="fa-solid fa-circle text-[6px]"></i>
                                                <%= admin.isActive ? 'Active' : 'Inactive' %>
                                            </span>
                                        </td>
                                        <td class="py-3 pr-4">
                                            <div class="flex items-center justify-end gap-3 text-xs">
                                                <a href="/superadmin/admins/<%= admin._id %>/edit"
                                                   class="text-gray-600 hover:text-green-700 font-medium inline-flex items-center gap-1" title="Edit">
                                                    <i class="fa-regular fa-pen-to-square"></i>
                                                    <span class="hidden sm:inline">Edit</span>
                                                </a>
                                                <form action="/superadmin/admins/<%= admin._id %>/toggle-status" method="POST" class="inline">
                                                    <button type="submit"
                                                            class="<%= admin.isActive ? 'text-red-600 hover:text-red-800' : 'text-green-700 hover:text-green-900' %> font-medium inline-flex items-center gap-1"
                                                            title="<%= admin.isActive ? 'Deactivate account' : 'Activate account' %>">
                                                        <i class="fa-solid fa-power-off"></i>
                                                        <span class="hidden sm:inline"><%= admin.isActive ? 'Deactivate' : 'Activate' %></span>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

        </main>
    </div>
</div>

<script>
    // ─── Sidebar drawer (mobile) ───
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('overlay');
    const menuToggle = document.getElementById('menuToggle');

    menuToggle?.addEventListener('click', () => {
        sidebar.classList.add('open');
        overlay.classList.remove('hidden');
    });
    overlay?.addEventListener('click', () => {
        sidebar.classList.remove('open');
        overlay.classList.add('hidden');
    });

    // ─── Password show/hide (mirrors the SPC login page) ───
    function toggleCeoPwd() {
        const password = document.getElementById('ceoPassword');
        const eyeIcon  = document.getElementById('ceoEyeIcon');
        if (password.type === 'password') {
            password.type = 'text';
            eyeIcon.classList.remove('fa-eye');
            eyeIcon.classList.add('fa-eye-slash');
        } else {
            password.type = 'password';
            eyeIcon.classList.remove('fa-eye-slash');
            eyeIcon.classList.add('fa-eye');
        }
    }

    // ─── Client-side search filter for the CEO accounts table ───
    const search = document.getElementById('ceoSearch');
    const rows   = document.querySelectorAll('#ceoTable tbody tr[data-search]');
    search?.addEventListener('input', (e) => {
        const q = e.target.value.trim().toLowerCase();
        rows.forEach(row => {
            const hay = row.getAttribute('data-search') || '';
            row.style.display = (!q || hay.includes(q)) ? '' : 'none';
        });
    });
</script>

</body>
</html>