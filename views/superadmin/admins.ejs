<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage CEOs | SPC</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 min-h-screen">

    <header class="bg-green-900 text-white p-5 flex justify-between items-center">
        <div>
            <h1 class="text-xl font-bold">SPC Integrated Recycling</h1>
            <p class="text-sm text-green-200">Super Admin Panel</p>
        </div>

        <a href="/superadmin/dashboard"
           class="bg-white text-green-900 px-4 py-2 rounded">
            Dashboard
        </a>
    </header>

    <main class="max-w-6xl mx-auto p-6">

        <h2 class="text-2xl font-bold text-gray-800 mb-6">
            Manage CEO Accounts
        </h2>

        <!-- Create CEO Form -->
        <div class="bg-white rounded-lg shadow p-6 mb-8">

            <h3 class="text-lg font-bold mb-5">
                Create New CEO Account
            </h3>

            <form action="/superadmin/admins/create" method="POST">

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                    <div>
                        <label class="block mb-2 font-medium">
                            Full Name
                        </label>

                        <input
                            type="text"
                            name="fullName"
                            required
                            class="w-full border rounded-lg p-3"
                            placeholder="Enter CEO full name"
                        >
                    </div>

                    <div>
                        <label class="block mb-2 font-medium">
                            Username
                        </label>

                        <input
                            type="text"
                            name="username"
                            required
                            class="w-full border rounded-lg p-3"
                            placeholder="Enter username"
                        >
                    </div>

                    <div>
                        <label class="block mb-2 font-medium">
                            Email Address
                        </label>

                        <input
                            type="email"
                            name="email"
                            required
                            class="w-full border rounded-lg p-3"
                            placeholder="Enter email"
                        >
                    </div>

                    <div>
                        <label class="block mb-2 font-medium">
                            Temporary Password
                        </label>

                        <input
                            type="password"
                            name="password"
                            minlength="8"
                            required
                            class="w-full border rounded-lg p-3"
                            placeholder="Minimum 8 characters"
                        >
                    </div>

                </div>

                <button
                    type="submit"
                    class="mt-6 bg-green-700 hover:bg-green-800 text-white px-6 py-3 rounded-lg"
                >
                    Create CEO Account
                </button>

            </form>
        </div>

        <!-- CEO Accounts Table -->
        <div class="bg-white rounded-lg shadow p-6">

            <h3 class="text-lg font-bold mb-5">
                Existing CEO Accounts
            </h3>

            <div class="overflow-x-auto">

                <table class="w-full text-left border-collapse">

                    <thead>
                        <tr class="bg-gray-100">
                            <th class="p-3 border">Full Name</th>
                            <th class="p-3 border">Username</th>
                            <th class="p-3 border">Email</th>
                            <th class="p-3 border">Status</th>
                        </tr>
                    </thead>

                    <tbody>

                        <% if (admins.length === 0) { %>

                            <tr>
                                <td colspan="4"
                                    class="p-5 text-center text-gray-500">
                                    No CEO accounts created yet.
                                </td>
                            </tr>

                        <% } else { %>

                            <% admins.forEach(admin => { %>

                                <tr>
                                    <td class="p-3 border">
                                        <%= admin.fullName %>
                                    </td>

                                    <td class="p-3 border">
                                        <%= admin.username %>
                                    </td>

                                    <td class="p-3 border">
                                        <%= admin.email %>
                                    </td>

                                    <td class="p-3 border">
                                        <% if (admin.isActive) { %>
                                            <span class="text-green-700 font-semibold">
                                                Active
                                            </span>
                                        <% } else { %>
                                            <span class="text-red-700 font-semibold">
                                                Inactive
                                            </span>
                                        <% } %>
                                    </td>
                                </tr>

                            <% }) %>

                        <% } %>

                    </tbody>

                </table>

            </div>
        </div>

    </main>

</body>
</html>