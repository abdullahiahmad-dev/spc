
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Branch Customers | SPC</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 min-h-screen">

    <div class="max-w-7xl mx-auto p-6">

        <div class="flex flex-wrap justify-between items-center gap-4 mb-6">
            <div>
                <h1 class="text-2xl font-bold text-gray-800">Customer Management</h1>
                <p class="text-gray-500">Customers registered under your branch.</p>
            </div>

            <div class="flex gap-3">
                <a href="/user/dashboard"
                   class="bg-gray-700 text-white px-4 py-2 rounded-lg">
                    Dashboard
                </a>

                <a href="/customers/new"
                   class="bg-green-700 text-white px-4 py-2 rounded-lg">
                    + Add Customer
                </a>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow overflow-hidden">

            <div class="p-5 border-b">
                <h2 class="font-bold text-lg">Registered Customers</h2>
                <p class="text-sm text-gray-500">
                    Total Customers: <%= customers.length %>
                </p>
            </div>

            <% if (customers.length === 0) { %>

                <div class="p-10 text-center text-gray-500">
                    <p class="text-lg font-semibold">No customers registered yet.</p>
                    <p class="mt-2">Click "Add Customer" to register your first customer.</p>
                </div>

            <% } else { %>

                <div class="overflow-x-auto">
                    <table class="w-full text-sm text-left">

                        <thead class="bg-gray-100 text-gray-700 uppercase">
                            <tr>
                                <th class="p-4">S/N</th>
                                <th class="p-4">Customer Name</th>
                                <th class="p-4">Type</th>
                                <th class="p-4">Phone</th>
                                <th class="p-4">Email</th>
                                <th class="p-4">Address</th>
                                <th class="p-4">Registered By</th>
                                <th class="p-4">Date Registered</th>
                            </tr>
                        </thead>

                        <tbody class="divide-y">

                            <% customers.forEach((customer, index) => { %>

                                <tr class="hover:bg-gray-50">

                                    <td class="p-4"><%= index + 1 %></td>

                                    <td class="p-4 font-semibold">
                                        <%= customer.customerName %>
                                    </td>

                                    <td class="p-4">
                                        <%= customer.customerType %>
                                    </td>

                                    <td class="p-4">
                                        <%= customer.phone %>
                                    </td>

                                    <td class="p-4">
                                        <%= customer.email || 'N/A' %>
                                    </td>

                                    <td class="p-4">
                                        <%= customer.address %>
                                    </td>

                                    <td class="p-4">
                                        <%= customer.createdBy ? customer.createdBy.fullName : 'N/A' %>
                                    </td>

                                    <td class="p-4">
                                        <%= new Date(customer.createdAt).toLocaleDateString() %>
                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>
                </div>

            <% } %>

        </div>

    </div>

</body>
</html>
