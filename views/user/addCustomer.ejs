
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register Customer | SPC</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 min-h-screen">

    <div class="max-w-4xl mx-auto p-6">

        <div class="flex justify-between items-center mb-6">
            <div>
                <h1 class="text-2xl font-bold text-gray-800">Register New Customer</h1>
                <p class="text-gray-500">Add a customer to your branch.</p>
            </div>

            <a href="/user/dashboard"
               class="bg-gray-700 text-white px-4 py-2 rounded-lg">
                Back to Dashboard
            </a>
        </div>

        <% if (error) { %>
            <div class="bg-red-100 text-red-700 p-3 rounded-lg mb-4">
                <%= error %>
            </div>
        <% } %>

        <form action="/customers/create" method="POST"
              class="bg-white p-6 rounded-xl shadow space-y-5">

            <div>
                <label class="block font-semibold mb-2">Customer Name *</label>
                <input type="text" name="customerName" required
                       class="w-full border rounded-lg p-3"
                       placeholder="Enter customer name">
            </div>

            <div>
                <label class="block font-semibold mb-2">Customer Type *</label>
                <select name="customerType" required
                        class="w-full border rounded-lg p-3">
                    <option value="Individual">Individual</option>
                    <option value="Business">Business</option>
                    <option value="Organization">Organization</option>
                </select>
            </div>

            <div class="grid md:grid-cols-2 gap-5">
                <div>
                    <label class="block font-semibold mb-2">Phone Number *</label>
                    <input type="tel" name="phone" required
                           class="w-full border rounded-lg p-3"
                           placeholder="Enter phone number">
                </div>

                <div>
                    <label class="block font-semibold mb-2">Email Address</label>
                    <input type="email" name="email"
                           class="w-full border rounded-lg p-3"
                           placeholder="Enter email address">
                </div>
            </div>

            <div>
                <label class="block font-semibold mb-2">Address *</label>
                <textarea name="address" required rows="3"
                          class="w-full border rounded-lg p-3"
                          placeholder="Enter customer address"></textarea>
            </div>

            <div>
                <label class="block font-semibold mb-2">Waste Source</label>
                <input type="text" name="wasteSource"
                       class="w-full border rounded-lg p-3"
                       placeholder="e.g. Household, Factory, Shop">
            </div>

            <div>
                <label class="block font-semibold mb-2">Additional Notes</label>
                <textarea name="notes" rows="3"
                          class="w-full border rounded-lg p-3"
                          placeholder="Additional information (optional)"></textarea>
            </div>

            <button type="submit"
                    class="w-full bg-green-700 hover:bg-green-800 text-white font-semibold p-3 rounded-lg">
                Register Customer
            </button>

        </form>

    </div>

</body>
</html>
