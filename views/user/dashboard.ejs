<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Branch Manager Dashboard | SPC</title>

    <!-- Same stack as the login + CEO dashboard -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <style>
        body {
            font-family: Arial, Helvetica, sans-serif;
        }

        .nav-item { transition: background 0.2s, box-shadow 0.2s; }
        .nav-item:hover { background: rgba(255,255,255,0.08); }
        .nav-item.active {
            background: #006b3c;
            box-shadow: inset 3px 0 0 #ffffff;
        }

        .kpi-card { transition: transform 0.2s, box-shadow 0.2s; }
        .kpi-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0,107,60,0.10);
        }

        @media (max-width: 1023px) {
            #sidebar {
                transform: translateX(-100%);
                transition: transform 0.25s ease;
            }
            #sidebar.open { transform: translateX(0); }
        }

        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-thumb { background: #cbd5d9; border-radius: 4px; }
        ::-webkit-scrollbar-track { background: transparent; }
    </style>
</head>

<body class="bg-gray-100 min-h-screen">

<%
// ─────────────────────────────────────────────────────────────
// Safe defaults so the page renders even if the Express route
// doesn't pass every local. Pass these from your route to override:
//
//   res.render('branch-manager-dashboard', {
//     user,              // { fullName: 'Musa Sani' }
//     branch,            // { branchName, branchCode, location, ... }
//     today,             // 'April 28, 2025'  (string)
//     kpis: {
//       purchase:  { value: '₦2,350,000', change: 8 },
//       sales:     { value: '₦3,120,000', change: 12 },
//       materials: { value: '12', label: 'Active types' }
//     },
//     recentReports: [
//       { id, date, type, amount, status, statusTone }
//     ]
//   });
//
// Reads via `locals.X` to avoid EJS `with(locals)` TDZ issues.
// ─────────────────────────────────────────────────────────────

const _user      = locals.user || {};
const mgrName    = (_user && _user.fullName) ? _user.fullName : 'Branch Manager';
const mgrInitial = mgrName.charAt(0).toUpperCase();

const _branch     = locals.branch || {};
const branchName  = _branch.branchName || 'your branch';

const today = locals.today ||
    new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });

const defKpis = {
    purchase:  { value: '₦2,350,000', change: 8 },
    sales:     { value: '₦3,120,000', change: 12 },
    materials: { value: '12', label: 'Active types' }
};
const _kpis = locals.kpis || {};
const k = {
    purchase:  Object.assign({}, defKpis.purchase,  _kpis.purchase  || {}),
    sales:     Object.assign({}, defKpis.sales,     _kpis.sales     || {}),
    materials: Object.assign({}, defKpis.materials, _kpis.materials || {})
};

const defReports = [
    { id: 'rpt-2025-04-28', date: '2025-04-28', type: 'Daily Report', amount: 3120000, status: 'Submitted', statusTone: 'success' },
    { id: 'rpt-2025-04-27', date: '2025-04-27', type: 'Daily Report', amount: 2580000, status: 'Submitted', statusTone: 'success' },
    { id: 'rpt-2025-04-26', date: '2025-04-26', type: 'Daily Report', amount: 2650000, status: 'Submitted', statusTone: 'success' },
    { id: 'rpt-2025-04-25', date: '2025-04-25', type: 'Daily Report', amount: 2420000, status: 'Submitted', statusTone: 'success' }
];
const recentReports = locals.recentReports || defReports;
const fmtNaira = n => '₦' + n.toLocaleString('en-NG');

const statusClass = {
    success: 'bg-green-100 text-green-800 border-green-200',
    pending: 'bg-amber-100 text-amber-800 border-amber-200',
    draft:   'bg-gray-100 text-gray-700 border-gray-200'
};
%>

<div class="flex min-h-screen">

    <!-- ───────────── Sidebar ───────────── -->
    <aside id="sidebar"
           class="fixed lg:static inset-y-0 left-0 z-40 w-64 bg-green-950 text-white flex flex-col">

        <!-- Brand -->
        <div class="px-5 py-5 border-b border-green-900/60 flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-green-700 flex items-center justify-center flex-shrink-0">
                <i class="fa-solid fa-recycle text-white text-lg"></i>
            </div>
            <div class="min-w-0">
                <h1 class="text-lg font-extrabold tracking-tight leading-tight">SPC</h1>
                <p class="text-[10px] uppercase tracking-wider text-green-300 truncate">Branch Manager</p>
            </div>
        </div>

        <!-- Nav -->
        <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">
            <a href="/branch/dashboard"
               class="nav-item active flex items-center gap-3 px-3 py-2.5 rounded-md text-sm font-medium">
                <i class="fa-solid fa-gauge-high w-5 text-center"></i>
                <span>Dashboard</span>
            </a>
            <a href="/branch/daily-report"
               class="nav-item flex items-center gap-3 px-3 py-2.5 rounded-md text-sm text-green-100">
                <i class="fa-solid fa-clipboard-list w-5 text-center"></i>
                <span>Daily Report</span>
            </a>
            <a href="/branch/materials"
               class="nav-item flex items-center gap-3 px-3 py-2.5 rounded-md text-sm text-green-100">
                <i class="fa-solid fa-recycle w-5 text-center"></i>
                <span>Materials</span>
            </a>
            <a href="/branch/price-list"
               class="nav-item flex items-center gap-3 px-3 py-2.5 rounded-md text-sm text-green-100">
                <i class="fa-solid fa-tags w-5 text-center"></i>
                <span>Price List</span>
            </a>
            <a href="/branch/reports"
               class="nav-item flex items-center gap-3 px-3 py-2.5 rounded-md text-sm text-green-100">
                <i class="fa-solid fa-folder-open w-5 text-center"></i>
                <span>Reports</span>
            </a>
            <a href="/branch/profile"
               class="nav-item flex items-center gap-3 px-3 py-2.5 rounded-md text-sm text-green-100">
                <i class="fa-solid fa-user w-5 text-center"></i>
                <span>Profile</span>
            </a>
        </nav>

        <!-- Sidebar footer (mini user card + logout) -->
        <div class="p-3 border-t border-green-900/60">
            <div class="flex items-center gap-3 px-2 py-2">
                <div class="w-9 h-9 rounded-full bg-green-700 flex items-center justify-center font-bold text-sm flex-shrink-0">
                    <%= mgrInitial %>
                </div>
                <div class="min-w-0 flex-1">
                    <p class="text-sm font-semibold truncate"><%= mgrName %></p>
                    <p class="text-[11px] text-green-300 truncate"><%= branchName %></p>
                </div>
                <form action="/logout" method="POST">
                    <button type="submit"
                            class="text-green-300 hover:text-white transition"
                            title="Logout">
                        <i class="fa-solid fa-right-from-bracket"></i>
                    </button>
                </form>
            </div>
        </div>
    </aside>

    <!-- Mobile overlay -->
    <div id="overlay" class="hidden lg:hidden fixed inset-0 bg-black/40 z-30"></div>

    <!-- ───────────── Main column ───────────── -->
    <div class="flex-1 flex flex-col min-w-0">

        <!-- Top header -->
        <header class="bg-white border-b border-gray-200 sticky top-0 z-20">
            <div class="flex items-center justify-between gap-3 px-4 sm:px-6 py-3">

                <div class="flex items-center gap-3 min-w-0">
                    <button id="menuToggle"
                            class="lg:hidden text-gray-600 hover:text-green-700 text-xl">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <div class="min-w-0">
                        <h2 class="text-base sm:text-lg font-bold text-gray-800 truncate">
                            Branch Manager <span class="text-gray-400 font-normal">—</span> <span class="text-green-700"><%= branchName %></span>
                        </h2>
                        <p class="text-[11px] sm:text-xs text-gray-500 truncate">Daily branch operations overview</p>
                    </div>
                </div>

                <div class="flex items-center gap-3 sm:gap-4 flex-shrink-0">
                    <!-- Date pill -->
                    <div class="hidden sm:flex items-center gap-2 bg-green-50 text-green-800 border border-green-200 rounded-md px-3 py-1.5 text-xs font-semibold">
                        <i class="fa-regular fa-calendar"></i>
                        <span><%= today %></span>
                    </div>

                    <!-- User -->
                    <div class="flex items-center gap-2">
                        <div class="w-9 h-9 rounded-full bg-green-700 text-white flex items-center justify-center font-bold text-sm">
                            <%= mgrInitial %>
                        </div>
                        <div class="hidden md:block leading-tight">
                            <p class="text-sm font-semibold text-gray-800"><%= mgrName %></p>
                            <p class="text-[11px] text-gray-500">Branch Manager · <%= branchName %></p>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <!-- Main content -->
        <main class="p-4 sm:p-6 flex-1">

            <!-- Welcome -->
            <div class="mb-6 flex items-start justify-between gap-4 flex-wrap">
                <div class="flex items-center gap-3 min-w-0">
                    <div class="w-11 h-11 rounded-full bg-green-700 text-white flex items-center justify-center font-bold text-base flex-shrink-0">
                        <%= mgrInitial %>
                    </div>
                    <div class="min-w-0">
                        <h3 class="text-xl sm:text-2xl font-bold text-gray-800 truncate">
                            Welcome, <%= mgrName %>
                        </h3>
                        <p class="text-gray-500 text-sm mt-0.5 truncate">
                            Branch Manager · <%= branchName %>
                        </p>
                    </div>
                </div>

                <!-- Mobile date pill (shown when header pill is hidden) -->
                <div class="sm:hidden flex items-center gap-2 bg-green-50 text-green-800 border border-green-200 rounded-md px-3 py-1.5 text-xs font-semibold">
                    <i class="fa-regular fa-calendar"></i>
                    <span><%= today %></span>
                </div>
            </div>

            <!-- KPI cards -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-6">

                <!-- Today's Purchase -->
                <div class="kpi-card bg-white rounded-lg shadow-sm border border-gray-100 p-5">
                    <div class="flex items-start justify-between">
                        <div class="min-w-0">
                            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Today's Purchases</p>
                            <p class="text-2xl font-bold text-gray-800 mt-1.5 truncate"><%= k.purchase.value %></p>
                        </div>
                        <div class="w-11 h-11 rounded-full bg-green-100 text-green-700 flex items-center justify-center flex-shrink-0">
                            <i class="fa-solid fa-cart-shopping"></i>
                        </div>
                    </div>
                    <div class="flex items-center gap-1.5 mt-3 text-xs">
                        <span class="text-green-700 font-semibold flex items-center gap-1">
                            <i class="fa-solid fa-arrow-up"></i> <%= k.purchase.change %>%
                        </span>
                        <span class="text-gray-400">vs yesterday</span>
                    </div>
                </div>

                <!-- Today's Sales -->
                <div class="kpi-card bg-white rounded-lg shadow-sm border border-gray-100 p-5">
                    <div class="flex items-start justify-between">
                        <div class="min-w-0">
                            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Today's Sales</p>
                            <p class="text-2xl font-bold text-gray-800 mt-1.5 truncate"><%= k.sales.value %></p>
                        </div>
                        <div class="w-11 h-11 rounded-full bg-green-100 text-green-700 flex items-center justify-center flex-shrink-0">
                            <i class="fa-solid fa-naira-sign"></i>
                        </div>
                    </div>
                    <div class="flex items-center gap-1.5 mt-3 text-xs">
                        <span class="text-green-700 font-semibold flex items-center gap-1">
                            <i class="fa-solid fa-arrow-up"></i> <%= k.sales.change %>%
                        </span>
                        <span class="text-gray-400">vs yesterday</span>
                    </div>
                </div>

                <!-- Total Materials -->
                <div class="kpi-card bg-white rounded-lg shadow-sm border border-gray-100 p-5">
                    <div class="flex items-start justify-between">
                        <div class="min-w-0">
                            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Total Materials</p>
                            <p class="text-2xl font-bold text-gray-800 mt-1.5 truncate"><%= k.materials.value %></p>
                        </div>
                        <div class="w-11 h-11 rounded-full bg-green-100 text-green-700 flex items-center justify-center flex-shrink-0">
                            <i class="fa-solid fa-recycle"></i>
                        </div>
                    </div>
                    <div class="flex items-center gap-1.5 mt-3 text-xs">
                        <span class="text-green-700 font-semibold flex items-center gap-1">
                            <i class="fa-solid fa-circle-check"></i> <%= k.materials.label %>
                        </span>
                    </div>
                </div>
            </div>

            <!-- Recent Daily Reports -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-5">
                <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
                    <div>
                        <h4 class="font-bold text-gray-800">Recent Daily Reports</h4>
                        <p class="text-xs text-gray-500">Latest submissions from this branch</p>
                    </div>
                    <div class="flex items-center gap-2">
                        <!-- Search -->
                        <div class="relative">
                            <span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-gray-400 text-xs">
                                <i class="fa-solid fa-magnifying-glass"></i>
                            </span>
                            <input id="reportSearch"
                                   type="text"
                                   placeholder="Search..."
                                   class="h-8 w-40 sm:w-56 rounded-md border border-gray-200 pl-7 pr-3 text-xs text-gray-700 focus:outline-none focus:border-green-700 focus:ring-2 focus:ring-green-700/10">
                        </div>
                        <a href="/branch/daily-report"
                           class="text-xs font-semibold text-green-700 hover:text-green-900 flex items-center gap-1 whitespace-nowrap">
                            View all <i class="fa-solid fa-arrow-right text-[10px]"></i>
                        </a>
                    </div>
                </div>

                <div class="overflow-x-auto -mx-1 px-1">
                    <table class="w-full text-sm" id="reportsTable" style="min-width: 640px">
                        <thead>
                            <tr class="text-left text-[11px] uppercase tracking-wide text-gray-500 border-b border-gray-200">
                                <th class="py-2 pr-4 font-semibold">Date</th>
                                <th class="py-2 pr-4 font-semibold">Type</th>
                                <th class="py-2 pr-4 font-semibold text-right">Total Amount</th>
                                <th class="py-2 pr-4 font-semibold">Status</th>
                                <th class="py-2 pr-4 font-semibold text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% recentReports.forEach((r) => { %>
                                <tr class="border-b border-gray-100 last:border-0 hover:bg-green-50/40 transition" data-search="<%= (r.date + ' ' + r.type + ' ' + r.status).toLowerCase() %>">
                                    <td class="py-3 pr-4">
                                        <div class="flex items-center gap-2.5">
                                            <span class="w-8 h-8 rounded-md bg-green-50 text-green-700 flex items-center justify-center text-xs flex-shrink-0">
                                                <i class="fa-regular fa-file-lines"></i>
                                            </span>
                                            <span class="font-medium text-gray-800"><%= r.date %></span>
                                        </div>
                                    </td>
                                    <td class="py-3 pr-4 text-gray-600"><%= r.type %></td>
                                    <td class="py-3 pr-4 text-right font-semibold text-gray-800"><%= fmtNaira(r.amount) %></td>
                                    <td class="py-3 pr-4">
                                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold border <%= statusClass[r.statusTone] || statusClass.draft %>">
                                            <i class="fa-solid fa-circle text-[6px]"></i>
                                            <%= r.status %>
                                        </span>
                                    </td>
                                    <td class="py-3 pr-4 text-right">
                                        <a href="/branch/daily-report/<%= r.id %>"
                                           class="inline-flex items-center gap-1 text-green-700 hover:text-green-900 font-semibold text-xs">
                                            View <i class="fa-solid fa-arrow-right text-[10px]"></i>
                                        </a>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="mt-4 bg-white rounded-lg shadow-sm border border-gray-100 p-5">
                <h4 class="font-bold text-gray-800 mb-1">Quick Actions</h4>
                <p class="text-xs text-gray-500 mb-4">Common tasks for your branch</p>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                    <a href="/branch/daily-report/new"
                       class="group flex items-center gap-3 p-3 rounded-md border border-gray-200 hover:border-green-300 hover:bg-green-50/50 transition">
                        <div class="w-9 h-9 rounded-md bg-green-100 text-green-700 flex items-center justify-center flex-shrink-0">
                            <i class="fa-solid fa-plus"></i>
                        </div>
                        <div class="min-w-0">
                            <p class="text-sm font-semibold text-gray-800">New Daily Report</p>
                            <p class="text-[11px] text-gray-500 truncate">Record today's branch activity</p>
                        </div>
                    </a>
                    <a href="/branch/materials"
                       class="group flex items-center gap-3 p-3 rounded-md border border-gray-200 hover:border-green-300 hover:bg-green-50/50 transition">
                        <div class="w-9 h-9 rounded-md bg-green-100 text-green-700 flex items-center justify-center flex-shrink-0">
                            <i class="fa-solid fa-recycle"></i>
                        </div>
                        <div class="min-w-0">
                            <p class="text-sm font-semibold text-gray-800">Manage Materials</p>
                            <p class="text-[11px] text-gray-500 truncate">View and update material catalog</p>
                        </div>
                    </a>
                    <a href="/branch/price-list"
                       class="group flex items-center gap-3 p-3 rounded-md border border-gray-200 hover:border-green-300 hover:bg-green-50/50 transition">
                        <div class="w-9 h-9 rounded-md bg-green-100 text-green-700 flex items-center justify-center flex-shrink-0">
                            <i class="fa-solid fa-tags"></i>
                        </div>
                        <div class="min-w-0">
                            <p class="text-sm font-semibold text-gray-800">View Price List</p>
                            <p class="text-[11px] text-gray-500 truncate">Check current material prices</p>
                        </div>
                    </a>
                </div>
            </div>

        </main>
    </div>
</div>

<script>
    // ─── Sidebar drawer (mobile) ───
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('overlay');
    const menuToggle = document.getElementById('menuToggle');

    menuToggle?.addEventListener('click', () => {
        sidebar.classList.add('open');
        overlay.classList.remove('hidden');
    });
    overlay?.addEventListener('click', () => {
        sidebar.classList.remove('open');
        overlay.classList.add('hidden');
    });

    // ─── Client-side search filter for the reports table ───
    const search = document.getElementById('reportSearch');
    const rows = document.querySelectorAll('#reportsTable tbody tr[data-search]');
    search?.addEventListener('input', (e) => {
        const q = e.target.value.trim().toLowerCase();
        rows.forEach(row => {
            const hay = row.getAttribute('data-search') || '';
            row.style.display = (!q || hay.includes(q)) ? '' : 'none';
        });
    });
</script>

</body>
</html>